# ListSync Nuxt Frontend Environment Configuration
# Copy this file to .env and configure as needed

# API Configuration
NUXT_PUBLIC_API_URL=http://localhost:4222
NUXT_PUBLIC_API_BASE=/api

# OIDC authentication (optional). When enabled, ListSync requires either an
# Authelia forward-auth header (through Nginx Proxy Manager) or a native OIDC
# session. Leave OIDC_ENABLED=false to preserve the old open behaviour.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://authelia.example.com
# OIDC_CLIENT_ID=listsync
# OIDC_CLIENT_SECRET=
# Alternatively, read the secret from a mounted file:
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# OIDC_REDIRECT_URI=https://listsync.example.com/auth/oidc/callback
# OIDC_SCOPES=openid email profile groups
# OIDC_ALLOWED_EMAILS=you@example.com
# OIDC_SESSION_HOURS=8
# Must be at least 32 characters. Used to seal the login session cookie.
# NUXT_SESSION_PASSWORD=

# Development Settings
# NODE_ENV=development
